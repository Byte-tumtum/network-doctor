{"nodes": [{"id": "readme_network_doctor", "label": "network-doctor", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs checks in order where each is a prerequisite for the next, so the first failing check read top-down is the earliest point the connection breaks. Linux-only because the gateway check parses /proc/net/route. Every check is IPv4-only and bounded by a 4-second timeout."}, {"id": "readme_link_check", "label": "Link Check", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passes when a non-loopback interface is up and running (cable/Wi-Fi present)."}, {"id": "readme_ip_address_check", "label": "IP Address Check", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passes when you hold a non-loopback, non-link-local IPv4; rejects 127/8 and 169.254/16 (no-DHCP)."}, {"id": "readme_gateway_check", "label": "Gateway Check", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passes when an IPv4 default route exists; read from /proc/net/route choosing the lowest metric."}, {"id": "readme_name_resolution_check", "label": "Name Resolution Check", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passes when the probe host resolves to an IPv4 via system resolution (/etc/hosts + resolvers)."}, {"id": "readme_internet_check", "label": "Internet Check", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passes when GET /generate_204 returns exactly 204; a captive portal's 200/redirect is a Fail."}, {"id": "readme_probe_host", "label": "Probe Host (connectivitycheck.gstatic.com)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolution and the internet check hit the same host so a single blocked host can't cause a misleading result."}, {"id": "readme_proc_net_route", "label": "/proc/net/route", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_generate_204", "label": "GET /generate_204", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_captive_portal", "label": "Captive Portal Detection", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A captive portal returning 200 or a redirect instead of the expected 204 is treated as a Fail."}, {"id": "readme_target_mode", "label": "Target Path Diagnosis Mode", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Given a target host, keeps the local-infra checks then probes the path to that host (DNS, TCP 443, TLS, HTTP, SSH 22) so the first failure shows exactly where the path breaks. Scheme and trailing slash in the argument are stripped."}, {"id": "readme_gateway_reachable_check", "label": "Gateway Reachable Check (ARP)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"i